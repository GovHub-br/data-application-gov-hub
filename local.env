# ============================================================
# local.env — TEMPLATE de variáveis de ambiente (SEM segredos).
# Copie para um .env local e preencha os valores reais. Este arquivo
# é versionado como exemplo; os .env com valores reais estão no
# .gitignore. O Docker lê infra/.env (rode o compose de dentro de infra/).
# ============================================================

# <---------- Airflow ---------->

AIRFLOW_IMAGE_NAME=<preencher>
AIRFLOW__CORE__FERNET_KEY=<gerar-com-python-cryptography-fernet>
AIRFLOW_HOME=<preencher>
AIRFLOW_USERNAME=<preencher>
AIRFLOW_PASSWORD=<definir-senha>
AIRFLOW_UID=<preencher>


# <---------- Postgres Airflow ---------->

POSTGRES_USER=<preencher>
POSTGRES_PASSWORD=<definir-senha>
POSTGRES_DB=<preencher>


# <---------- Postgres Data Warehouse ---------->
POSTGRES_USER_DW=<preencher>
POSTGRES_PASSWORD_DW=<definir-senha>
POSTGRES_DB_DW=<preencher>


# <---------- MinIO ---------->
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=<definir-access-key>
MINIO_SECRET_KEY=<definir-secret>
MINIO_BUCKET=<preencher>
MINIO_REGION=us-east-1
MINIO_URL_STYLE=path
MINIO_USE_SSL=false
