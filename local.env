# <---------- Airflow ---------->
AIRFLOW_IMAGE_NAME=apache/airflow:latest
AIRFLOW__CORE__FERNET_KEY='lmnHJcz5u4D8SPEeD4qwAf1TUk_yLXXnQfwlvQ8MXsU='
AIRFLOW_HOME=/opt/airflow/
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# <---------- Postgres Airflow ---------->
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# <---------- Postgres Data Warehouse ---------->
DB_DW_HOST=postgres
DB_DW_PORT=5432
DB_DW_USER=postgres
DB_DW_PASSWORD=postgres
DB_DW_DBNAME=postgres
DB_DW_SCHEMA=ipea

POSTGRES_USER_DW=postgres_dw
POSTGRES_PASSWORD_DW=postgres_dw
POSTGRES_DB_DW=data_warehouse

# <---------- dbt Target ---------->
# Options: prod | duckdb | duckdb_postgres
DBT_ENGINE=duckdb
DBT_THREADS=4
DBT_DATABASE=dw
DBT_SCHEMA=main

# <---------- Raw Storage Selection ---------->
# Options: s3 | adls | gcs
OBJECT_STORAGE=s3
STORAGE_BACKEND=s3
RAW_STORAGE_CONTAINER=data-lake-ipea
ENABLE_POSTGRES_INGEST=false

# <---------- S3-Compatible Raw Storage ---------->
# Local MinIO is just S3 with a custom endpoint.
S3_ENDPOINT=http://minio:9000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_URL_STYLE=path
S3_USE_SSL=false

# Compatibility aliases used by local MinIO helpers.
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=data-lake-ipea
MINIO_REGION=us-east-1
MINIO_URL_STYLE=path
MINIO_USE_SSL=false

# <---------- ADLS Raw Storage ---------->
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_CONTAINER=data-lake-ipea
# AZURE_PROVIDER=credential_chain
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# <---------- GCS Raw Storage ---------->
# GCS_BUCKET=data-lake-ipea
# GCS_HMAC_KEY=
# GCS_HMAC_SECRET=

# <---------- DuckDB ---------->
DUCKDB_PATH_IPEA=/opt/airflow/duckdb/ipea.duckdb
DUCKDB_PATH_MIR=/opt/airflow/duckdb/mir.duckdb
