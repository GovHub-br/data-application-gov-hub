# Python virtual environments
.venv/
venv/
ENV/

# Poetry
dist/
**/*.pyc
**/*.lock
__pycache__/
.poetry/
requirements.generated.txt

# Cache directories
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Coverage reports
.coverage
coverage.xml
htmlcov/

# IDE specific files
.idea/
.vscode/
*.swp
*.swo

# Environment variables — ignora TODO .env real (com segredos), em qualquer pasta.
# Exceções versionadas: os templates *.example e o local.env (já sanitizado
# como template, sem segredos). NUNCA reescrever local.env com valores reais.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
!local.env

# Build directories
build/
*.egg-info/

# DBT
target/
dbt_packages/
logs/

# Jupyter
**/*.ipynb_checkpoints/
**/*.ipynb

# System files
.DS_Store
Thumbs.db

# Claude Code — só o que é pessoal fica de fora. As skills e o settings.json
# são versionados de propósito: é assim que a equipe recebe tudo ao clonar.
.claude/settings.local.json
.claude/*.local.json

# Site de documentação — a saída do build e o virtualenv são gerados. O acervo
# em docs-pages/src/_data/ É versionado: sem ele o CI não reproduz o site.
docs-pages/site/
docs-pages/.venv/

# VPN 
/connect.sh
*.ovpn
*.p12

# Airflow local files
airflow.db
webserver_config.py

# Dados de pipeline (extracoes brutas, parquet, checkpoints) -- gerados
# localmente por quem roda as DAGs, nao pertencem ao repositorio. Mantem a
# estrutura de pastas via .gitkeep.
data/**
!data/**/
!data/**/.gitkeep
# Revisoes semanais (md/html/pdf) -- geradas pela skill revisao-semanal. Sao
# insumo de acompanhamento, nao artefato do projeto: o historico do repo nao
# deve encher de relatorio semanal. Para divulgar, comente numa issue.
relatorios/

# Dependencia do conversor de Markdown->HTML das skills (accountability-report
# e revisao-semanal). Instalada sob demanda na primeira geracao de PDF.
node_modules/
