AIRFLOW_UID=50000
AIRFLOW_HOME=/opt/airflow
AIRFLOW_VERSION=3.2.2
PYTHON_VERSION=3.11
AIRFLOW_BUILD_TARGET=airflow-dev

POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Criptografa passwords/extra das Connections. Se vazio, o default do
# docker-compose.yml ja resolve pra dev local -- mas em producao, defina um
# valor real e NUNCA troque sem antes rodar `airflow rotate-fernet-key`
# (trocar sem rotacionar torna toda Connection/Variable sensivel existente
# indecifravel, exigindo apagar e recriar tudo -- ja aconteceu aqui).
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow
AIRFLOW_PRUNE_STALE_DAGS=true

# Segredos internos do Airflow (auth entre os subprocessos do `airflow
# standalone`) -- se ficarem vazios, cada subprocesso gera um valor
# aleatorio proprio e as tasks falham com "Invalid auth token: Signature
# verification failed". Fixe um valor real (ex.: openssl rand -hex 32) em
# producao; em dev local o default do docker-compose.yml ja resolve.
AIRFLOW__API__SECRET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=

AF_READ_ONLY=false

# <---------- BSC/SERPRO (extracao_bbagil_dag / extracao_beneficiarios_bbagil_dag) ---------->
SCA_TOKEN_URL=https://bsc.cultura.gov.br/sca/oauth/token
SCA_CLIENT_ID=
SCA_CLIENT_SECRET=
BSC_BASE_URL=https://bsc.cultura.gov.br
BSC_CPF_CONSULTA=
BSC_USUARIO=minc.automacao
BSC_IP_ORIGEM=127.0.0.1
BSC_IP_USUARIO=127.0.0.1
BSC_MAX_CONCURRENT_REQUESTS=5
BSC_REQUEST_THROTTLE_SECONDS=1.05
BSC_CADUNICO_AUTHORIZATION_ID=
BSC_CADUNICO_AUTHORIZATION_ID_TYPE=Processo
# Diretorio de dados locais do pipeline BSC/PNAB (mapeado como volume no
# docker-compose.yml em ../data:/opt/airflow/data/)
BSC_PNAB_DATA_DIR=/opt/airflow/data

# <---------- Transferegov (descoberta de agencia/conta dos entes) ---------->
# Lista de codigos de programa a consultar vem da Variavel do Airflow
# "transferegov_programas_ids", nao de arquivo/env.
# Default: <BSC_PNAB_DATA_DIR>/transferegov/logs
TRANSFEREGOV_LOG_DIR=
